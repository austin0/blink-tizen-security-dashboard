# Copy to .env if you run docker compose with an env file.
TZ=Europe/Copenhagen
LOG_LEVEL=INFO
BLINK_AUDIO=1
BLINK_AUDIO_TRACK=0
MAX_LIVE_SECONDS=285

# Optional: require this token on every API/WebSocket request.
# Enter the same value in the TV app settings (red key).
# BRIDGE_TOKEN=change-me

# Optional: where the bridge stores its Blink session.
# BLINK_DATA_DIR=/data
